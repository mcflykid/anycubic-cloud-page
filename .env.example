# Fill locally and protect with chmod 600 .env; never commit this personalized file.
# After successful startup, ANYCUBIC_PASSWORD and WEB_PASSWORD may be emptied.
# Use single quotes around passwords containing $ or # to keep them literal.
ANYCUBIC_EMAIL='votre-compte@example.com'
ANYCUBIC_PASSWORD='votre-mot-de-passe-anycubic'
WEB_PASSWORD='choisissez-un-mot-de-passe-web-long'
# This is a separate login for the web page.
WEB_USER=admin
PUBLIC_ORIGIN=http://localhost:8080
# Empty hides both workshop links; HTTP(S) or relative paths only.
HOME_URL=/imprimante.html
WEB_PORT=8080
BIND_ADDRESS=127.0.0.1
# All persistent data stays under this directory, relative to the Compose file.
APPDATA_DIR=./appdata
TZ=Europe/Paris
PUID=1000
PGID=1000
# Optional alternative to the account; leave email/password empty in token mode.
ANYCUBIC_TOKEN=
PRINTER_ID=
# Optional slicer watcher, only with compose.slicer.yaml:
# SLICER_LOG_DIR=/path/to/AnycubicSlicerNext/log

# Proxy en conteneur : les deux valeurs évitent de gérer le réseau d’un autre projet.
# PROXY_NETWORK=proxy-shared
# PROXY_NETWORK_EXTERNAL=true
